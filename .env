POSTGRES_PASSWORD=dragtable_password
TARGET_ADMIN_URL=postgres://dragtable:dragtable_password@127.0.0.1:5432/postgres
# DATABASE_URL=postgres://dragtable:subham59036@127.0.0.1:5432/dragtable_control

# Host shown in external Postgres connection URLs (use your LAN IP for other devices)
TARGET_DB_HOST=127.0.0.1
TARGET_DB_PORT=5432

# Leave empty so the browser uses the same hostname as the page + :3001
PUBLIC_API_URL=
NEXT_PUBLIC_API_URL=

# Multi-device: open CORS (reflect any Origin). Set CORS_ALLOW_ALL=0 to restrict.
CORS_ALLOW_ALL=1
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Bind API on all interfaces (required for LAN)
HOST=0.0.0.0
PORT=3001

# HTTP only for local/LAN — never set COOKIE_SECURE=1 without HTTPS
COOKIE_SECURE=0